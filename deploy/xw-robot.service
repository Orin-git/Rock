[Unit]
Description=Xiaowei Gen2 robot stack (Docker ros2_humble_dev + Web :9000)
Documentation=file:///home/radxa/ros2_ws/doc/ARCHITECTURE.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=radxa
Group=docker
Environment=HOME=/home/radxa
Environment=XW_CONTAINER=ros2_humble_dev
Environment=USE_SIM_HW=true
Environment=USE_SIM_LIDAR=false
Environment=LIDAR_PORT=/dev/radar
Environment=LIDAR_BAUDRATE=1000000
Environment=USE_WEB=true
Environment=USE_FOXGLOVE=true
Environment=PROFILE=normal
# Delay lidar motor after Web is up (inrush can brown-out / drop SSH)
Environment=XW_LIDAR_START_DELAY=30
# Give docker a moment after boot
ExecStartPre=/bin/sleep 8
ExecStart=/home/radxa/ros2_ws/scripts/start_robot_host.sh
ExecStop=/usr/bin/docker exec ros2_humble_dev bash -c 'pkill -f "ros2 launch xw_bringup" 2>/dev/null || pkill -f robot.launch.py 2>/dev/null || true'
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xw-robot

[Install]
WantedBy=multi-user.target
