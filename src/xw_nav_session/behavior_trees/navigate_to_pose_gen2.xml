<!-- Gen2 NavigateToPose: 1 Hz replan, bounded recoveries (clear / spin / backup / wait).
     Note: do NOT wrap FollowPath in ReactiveSequence+IsPathValid — on this stack
     IsPathValid flaps FAILURE and preempts FollowPath, so cmd_vel_nav never flows. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearLocal">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
          <Sequence name="ClearAndBackup">
            <ClearEntireCostmap name="ClearLocal-Backup" service_name="local_costmap/clear_entirely_local_costmap"/>
            <BackUp backup_dist="0.60" backup_speed="0.15"/>
          </Sequence>
          <Sequence name="ClearBothAndSpin">
            <ClearEntireCostmap name="ClearLocal-Spin" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobal-Spin" service_name="global_costmap/clear_entirely_global_costmap"/>
            <Spin spin_dist="1.05"/>
          </Sequence>
          <Wait wait_duration="3.0"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
