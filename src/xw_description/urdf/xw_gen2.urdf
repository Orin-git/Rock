<?xml version="1.0"?>
<robot name="xw_gen2">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.45 0.35 0.18"/>
      </geometry>
      <material name="body">
        <color rgba="0.2 0.2 0.25 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.45 0.35 0.18"/>
      </geometry>
    </collision>
  </link>

  <!-- LiDAR: yaw=π — physical RPLidar angle-0 faced robot rear (front/rear & left/right swapped on UI).
       Do NOT also set rplidar inverted:=true (would double-flip). Verify: obstacle ahead → short range near scan angle π in lidar_link / front after offset. -->
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- front_up → /camera/front_up/... ; follow (+ fall). Optical-ish RPY (Z forward).
       Physically stacked: almost-level cam on TOP, slightly-up cam below. -->
  <link name="camera_front_up_link"/>
  <joint name="camera_front_up_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_up_link"/>
    <origin xyz="0.251 0 0.49" rpy="-1.33 0 -1.5708"/>
  </joint>

  <!-- front_down → /camera/front_down/... ; fall (+ nav near-ground).
       May publish upside-down; xw_perception down_rotate_180 corrects for detect. -->
  <link name="camera_front_down_link"/>
  <joint name="camera_front_down_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_down_link"/>
    <origin xyz="0.251 0 0.16" rpy="-2.01 0 -1.5708"/>
  </joint>

  <!-- WT901C485 at 49cm above ground (z=0.37 above base center) → /imu/data (frame_id=imu_link); fused by ekf_node (vyaw). -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.37" rpy="0 0 0"/>
  </joint>

  <!-- Legacy rear placeholder (unused); prefer camera_front_down_link. -->
  <link name="camera_rear_link"/>
  <joint name="camera_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
    <origin xyz="-0.18 0 0.25" rpy="0 0 3.14159"/>
  </joint>

  <link name="ultrasonic_front_link"/>
  <joint name="ultrasonic_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front_link"/>
    <origin xyz="0.22 0 0.08" rpy="0 0 0"/>
  </joint>
</robot>
