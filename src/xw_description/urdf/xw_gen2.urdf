<?xml version="1.0"?>
<robot name="xw_gen2">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.45 0.35 0.18"/>
      </geometry>
      <material name="body">
        <color rgba="0.2 0.2 0.25 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.45 0.35 0.18"/>
      </geometry>
    </collision>
  </link>

  <!-- LiDAR: yaw=0 assumes driver angle 0 == robot +X. Verify: obstacle ahead → short range near scan angle 0.
       If 180° flipped, change ONLY this joint yaw to π (do not also set driver inverted). -->
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
  </joint>

  <!-- Cam1 (down-tilt) → /camera/front/... ; follow + near obstacles. Optical-ish RPY (Z forward). -->
  <link name="camera_front_link"/>
  <joint name="camera_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_link"/>
    <origin xyz="0.18 0 0.25" rpy="-1.3955 0 -1.5708"/>
  </joint>

  <!-- Cam2 (up-tilt) → /camera/front_2/... ; high / hanging obstacles. -->
  <link name="camera_front_2_link"/>
  <joint name="camera_front_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_2_link"/>
    <origin xyz="0.18 0 0.28" rpy="-1.1 0 -1.5708"/>
  </joint>

  <!-- Independent IMU placeholder (robot center). Driver → /imu/data, frame_id=imu_link. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Legacy rear placeholder (unused); prefer camera_front_2_link. -->
  <link name="camera_rear_link"/>
  <joint name="camera_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
    <origin xyz="-0.18 0 0.25" rpy="0 0 3.14159"/>
  </joint>

  <link name="ultrasonic_front_link"/>
  <joint name="ultrasonic_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front_link"/>
    <origin xyz="0.22 0 0.08" rpy="0 0 0"/>
  </joint>
</robot>
